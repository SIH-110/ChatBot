# =============================================================================
# DoJ Chatbot Backend — Environment Configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# ---- Application ----
APP_NAME="DoJ Virtual Assistant API"
APP_ENV=development                 # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# ---- CORS (comma-separated list of allowed frontend origins) ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Groq (LLM reasoning / chat) ----
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=1024
GROQ_TIMEOUT_SECONDS=30

# ---- Sarvam (Indian-language STT / TTS / Translation) ----
SARVAM_API_KEY=sk_j7q1u5o9_mBK0h1K53iRZpzi2Su39ZTcn
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
SARVAM_TIMEOUT_SECONDS=30

# ---- RAG / Knowledge base ----
KB_RAW_DIR=data/knowledge_base/raw
KB_INDEX_DIR=data/knowledge_base/index
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.08

# ---- Admin ----
# Simple shared-secret header required to upload/delete knowledge base documents.
# Replace with proper auth (OAuth2/JWT + role check) before production deployment.
ADMIN_API_KEY=change_this_admin_key

# ---- Rate limiting ----
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_VOICE=10/minute
